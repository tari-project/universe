{
  "name": "tari-universe-playwright",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:l2": "playwright test --config playwright.l2.config.ts",
    "test:l2:ui": "playwright test --config playwright.l2.config.ts --ui",
    "test:l2:headed": "playwright test --config playwright.l2.config.ts --headed",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
