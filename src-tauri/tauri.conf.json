{
    "version": "1.6.14",
    "productName": "Tari Universe (Alpha)",
    "mainBinaryName": "Tari Universe (Alpha)",
    "identifier": "com.tari.universe.alpha",
    "build": {
        "beforeDevCommand": "pnpm run dev",
        "beforeBuildCommand": "pnpm run build",
        "frontendDist": "../dist",
        "devUrl": "http://localhost:1420"
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "macOS": {
            "providerShortName": "Tari Labs, LLC"
        },
        "linux": {
            "appimage": {
                "bundleMediaFramework": true
            }
        },
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico",
            "icons/icon.png",
            "icons/StoreLogo.png",
            "icons/systray_icon.icns",
            "icons/systray_icon.ico",
            "icons/systray_icon.png"
        ],
        "copyright": "Copyright (c) 2026 Tari Labs, LLC",
        "shortDescription": "Tari Universe is a mining app for Tari.",
        "longDescription": "Introducing Tari Universe, the beautifully simple mining app for Tari. Install it on your Mac or PC and start mining Tari with one click.",
        "publisher": "Tari Labs, LLC",
        "createUpdaterArtifacts": true,
        "externalBin": ["binaries/process-wrapper"]
    },
    "app": {
        "security": {
            "capabilities": ["desktop-capability", "default", "migrated"],
            "dangerousDisableAssetCspModification": ["style-src"],
            "csp": {
                "default-src": "'self' tauri: https: http://localhost:* http://127.0.0.1:*",
                "script-src": "'self' 'wasm-unsafe-eval'",
                "style-src": "'self' 'unsafe-inline'",
                "connect-src": [
                    "'self'",
                    "https:",
                    "wss://ut.tari.com",
                    "wss://relay.walletconnect.org",
                    "https://rpc.ankr.com/eth",
                    "https://ethereum-sepolia-rpc.publicnode.com",
                    "tauri:",
                    "tauri://localhost:*",
                    "http://localhost:*",
                    "http://127.0.0.1:*",
                    "ipc:",
                    "http://ipc.localhost",
                    "data:",
                    "blob:"
                ],
                "worker-src": "'self' blob:",
                "img-src": "'self' data: blob: https://*.twimg.com http://127.0.0.1 http://127.0.0.1/ http://127.0.0.1:* http://localhost http://localhost/ http://localhost:* https://static.tari.com https://static.tari.com/* https://lh3.googleusercontent.com",
                "media-src": "'self' data: blob: tauri: https:",
                "object-src": "'none'",
                "base-uri": "'self'",
                "form-action": "'self'",
                "frame-ancestors": "'none'"
            },
            "assetProtocol": {
                "enable": true,
                "scope": ["**"]
            },
            "pattern": {
                "use": "isolation",
                "options": {
                    "dir": "../dist-isolation"
                }
            }
        },
        "trayIcon": {
            "id": "universe-tray-id",
            "iconPath": "icons/systray_icon.ico",
            "iconAsTemplate": true
        },
        "macOSPrivateApi": true,
        "withGlobalTauri": false,
        "windows": [
            {
                "title": "Tari Universe (Alpha) | Testnet",
                "label": "main",
                "resizable": true,
                "fullscreen": false,
                "transparent": false,
                "visible": false,
                "center": true,
                "useHttpsScheme": true,
                "width": 1280,
                "height": 760,
                "minWidth": 1152,
                "minHeight": 684
            }
        ]
    },
    "plugins": {
        "updater": {
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYxNUJBOEFEQkQ4RjJBMjYKUldRbUtvKzlyYWhiOFJIUmFFditENVV3d3hRbjNlZm1DMi9aMjluRUpVdHhQTytadTV3ODN3bUMK",
            "endpoints": ["https://raw.githubusercontent.com/tari-project/universe/main/.updater/alpha-latest.json"],
            "windows": {
                "installMode": "passive"
            }
        },
        "cli": {
            "args": [
                {
                    "name": "import-backup",
                    "description": "Imports a minotari node backup file",
                    "takesValue": true
                },
                {
                    "name": "headless",
                    "description": "Run headless with remote-ui WebSocket bridge instead of a native window",
                    "takesValue": false
                }
            ]
        }
    }
}
